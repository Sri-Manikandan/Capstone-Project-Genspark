# Presidio LLM gateway (Anthropic-compatible)
ANTHROPIC_BASE_URL=https://proxy.llm-gateway.ready.presidio.com
ANTHROPIC_AUTH_TOKEN=replace-me-do-not-commit
# Existing EMS REST API base URL (see EMSApplicationLayer launchSettings.json)
EMS_API_BASE_URL=http://localhost:5222
# JWT validation — must match EMS appsettings Jwt:Key / Jwt:Issuer / Jwt:Audience
JWT_SIGNING_KEY=replace-me-must-match-ems-jwt-key
JWT_ISSUER=EMSApi
JWT_AUDIENCE=EMSClient
# Comma-separated browser origins allowed to call this service (production only —
# leave unset in dev, where the Angular proxy makes requests same-origin).
CORS_ALLOWED_ORIGINS=
